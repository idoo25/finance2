# Copy to .env. The whole system runs FREE with NO API KEYS.

# Database. Defaults to local SQLite if unset.
# Production example: postgresql+psycopg://gpmi:gpmi@postgres:5432/gpmi
DATABASE_URL=sqlite:///./gpmi.db

# Data mode:
#   1 = mock CSV (offline, deterministic, the default)
#   0 = live keyless sources (Stooq, Yahoo Finance, ECB, Frankfurter)
GPMI_USE_MOCK=1

# Where the mock CSV adapter reads from (only used when GPMI_USE_MOCK=1).
GPMI_MOCK_DATA_DIR=./data/mock

# Collection interval for the scheduler loop (seconds).
GPMI_INTERVAL_SECONDS=3600

# OPTIONAL extra sources (not required; the default config is fully keyless).
# Only used if you add alpha_vantage / fred entries back into sources.yaml.
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
