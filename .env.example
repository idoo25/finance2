# Copy to .env and fill in. Never commit real keys.

# Database. Defaults to local SQLite if unset.
# Production example: postgresql+psycopg://gpmi:gpmi@postgres:5432/gpmi
DATABASE_URL=sqlite:///./gpmi.db

# Optional free-tier API keys. Adapters that need a key are skipped if unset.
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Where mock CSV adapters read from.
GPMI_MOCK_DATA_DIR=./data/mock
